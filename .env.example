# Supabase (já usados pelo projeto)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe — configurar nos secrets das Edge Functions (Supabase / Lovable)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_STUDIO=price_...
# STRIPE_PRICE_AGENCY=price_...
# SITE_URL=https://som-sistemaoperacionaldamarca.netlify.app
#
# Antes do primeiro pagamento real:
# 1. Webhook Stripe → POST {SUPABASE_URL}/functions/v1/stripe-webhook
#    Eventos: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed
# 2. No Stripe Dashboard: Customer Portal ativo (cartão, faturas, cancelar)
# 3. Teste ponta a ponta em modo test: pagar, convite por e-mail, login,
#    criar 1 cliente, upgrade de plano, cancelar e confirmar que o acesso some
# 4. Aplique a migration 20260831120000_scale_billing_and_limits.sql no SQL Editor
# Termos e privacidade ficam no site (/termos, /privacidade). O checkout não exige
# mais a URL dos termos no Dashboard do Stripe.

# Resumo de alterações da cliente para o gestor (Edge Function send-gestor-digest)
# RESEND_API_KEY=re_...
# RESEND_FROM=SOM <notificacoes@seudominio.com>
# DIGEST_CRON_SECRET=cole-um-segredo-longo-aleatorio
# SITE_URL já é usado no link "Abrir calendário"

# Links de atendimento (landing / bot WhatsApp) — opcionais no front
# VITE_CONTACT_CALENDAR_URL=https://cal.com/seu-usuario/chamada-som
# VITE_CONTACT_VIDEO_URL=https://www.youtube.com/watch?v=...
